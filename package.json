{
  "name": "lifepilot-ai",
  "version": "1.0.0",
  "description": "LifePilot AI — Student Life Operating System",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js"
